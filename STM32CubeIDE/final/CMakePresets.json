{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BATTERY_LOAD": "OFF"
            }
        },
        {
            "name": "Battery",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "PD_VBUS_PATH_CHARGER": "OFF",
                "BATTERY_LOAD": "ON"
            }
        },
        {
            "name": "EprPps",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BATTERY_LOAD": "OFF",
                "PD_VBUS_PATH_CHARGER": "ON",
                "PD_VCONN": "ON",
                "PD_BENCH_15V": "ON",
                "PD_BENCH_20V": "ON",
                "PD_BENCH_PPS": "ON",
                "PD_BENCH_EPR_28V": "ON",
                "PD_BENCH_EPR_36V": "ON",
                "PD_BENCH_EPR_48V": "ON"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BATTERY_LOAD": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Battery",
            "configurePreset": "Battery"
        },
        {
            "name": "EprPps",
            "configurePreset": "EprPps"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        }
    ]
}
