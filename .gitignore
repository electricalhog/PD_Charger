# Ignore STM32CubeIDE build output directories
/STM32CubeIDE/**/Debug/
/STM32CubeIDE/**/Release/
/STM32CubeIDE/**/build/

# Optional: common binary outputs (kept under build dirs above)
#*.elf
#*.hex
#*.bin

# Agentic bring-up tools (tools/bringup)
/bringup_out/
/tools/bringup/bringup.local.toml
/tools/bringup/.venv/
__pycache__/
.pytest_cache/

# Vendor datasheets: keep local copies out of this public repo (see KiCad/datasheets/README.md)
/KiCad/datasheets/*.pdf
