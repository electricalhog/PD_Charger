{
    "configurations": [
        {
            "name": "STM32",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "DEBUG",
                "USE_HAL_DRIVER",
                "STM32G474xx"
            ],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
