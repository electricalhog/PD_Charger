            "cppStandard": "gnu++14",
            "intelliSenseMode": "linux-gcc-arm",
            "compileCommands": "${workspaceFolder}/STM32CubeIDE/final/build/Debug/compile_commands.json"
        }
    ],
    "version": 4
}