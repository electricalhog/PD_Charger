{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: final",
      "type": "shell",
      "command": "make",
      "args": ["-C", "${workspaceFolder}/STM32CubeIDE/final", "-j4"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Build STM32CubeIDE final project"
    },
    {
      "label": "Flash: final (ST-LINK)",
      "type": "shell",
      "command": "STM32_Programmer_CLI",
      "args": [
        "-c", "port=SWD",
        "-w", "${workspaceFolder}/STM32CubeIDE/final/build/final.elf",
        "-v",
        "-g"
      ],
      "dependsOn": ["Build: final"],
      "problemMatcher": [],
      "detail": "Program ELF to target via ST-LINK and run"
    }
  ]
}
