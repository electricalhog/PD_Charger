{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: STM32 Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Flash: final (ST-LINK)",
            // Explicitly set the target MCU so the ST-LINK GDB server can start
            "deviceName": "STM32G474RE",
            // Keep run-to-main behavior
            "runEntry": "main",
            "runToEntryPoint": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/STM32CubeIDE/final/build/final.elf"
                }
            ]
        }
    ]
}